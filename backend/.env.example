# MarkLoss Backend Environment Configuration

# Gemini API Key (Required for live AI transcription and hints; leave blank for DEMO_MODE)
LLM_API_KEY=

# LLM Provider and Models
LLM_PROVIDER=gemini
LLM_MODEL_VISION=gemini-2.5-flash
LLM_MODEL_TEXT=gemini-2.5-flash

# Operational Flags
# Set to true to force deterministic mock responses using bundled sample fixtures without hitting Gemini API
DEMO_MODE=false

# Request Timeout (seconds)
TIMEOUT_SECONDS=30.0

# CORS Configuration (comma-separated origins or * for all)
ALLOWED_ORIGINS=*
