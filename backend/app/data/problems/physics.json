      },
      {
        "id": "unit",
        "label": "Unit",
        "marks": 1,
        "check": "unit",
        "accept": ["m", "meter", "metre", "meters", "metres"]
      }
    ]
  },
  {
    "id": "phy-work-06",
    "subject": "physics",
    "class": 11,
    "statement": "A body of mass 4 kg moving with velocity 5 m/s is brought to rest by a constant braking force. Calculate the work done by the braking force.",
    "expected": { "value": -50.0, "unit": "J" },
    "rubric": [
      {
        "id": "formula",
        "label": "Work-Energy Theorem",
        "marks": 1,
        "check": "formula",
        "accept": ["W = 0.5 * m * (v**2 - u**2)", "W = (1/2) * m * (v**2 - u**2)", "W = 0.5 * m * v**2 - 0.5 * m * u**2", "Delta_K = 0.5 * m * v**2 - 0.5 * m * u**2"]
      },
      {
        "id": "substitution",
        "label": "Substitution",
        "marks": 1,
        "check": "substitution",
        "expect": { "m": 4.0, "u": 5.0, "v": 0.0 }
      },
      {
        "id": "calculation",
        "label": "Work Calculation",
        "marks": 1,
        "check": "numeric",
        "target": -50.0,
        "tolerance": 0.1,
        "depends_on": "substitution"
      },
      {
        "id": "unit",
        "label": "Unit",
        "marks": 1,
        "check": "unit",
        "accept": ["J", "joule", "joules", "N m", "N*m"]
      }
    ]
  },
