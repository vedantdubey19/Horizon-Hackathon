        "id": "substitution",
        "label": "Substitution",
        "marks": 1,
        "check": "substitution",
        "expect": { "u": 0.0, "a": 2.5, "t": 8.0 }
      },
      {
        "id": "calculation",
        "label": "Final Velocity Calculation",
        "marks": 1,
        "check": "numeric",
        "target": 20.0,
        "tolerance": 0.01,
        "depends_on": "substitution"
      },
      {
        "id": "unit",
        "label": "Unit",
        "marks": 1,
        "check": "unit",
        "accept": ["m/s", "m s^-1", "m/sec", "meters per second", "metres per second"]
      }
    ]
  },
  {
