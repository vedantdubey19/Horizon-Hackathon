[
  {
    "id": "phy-ohm-01",
    "subject": "physics",
    "class": 10,
    "statement": "A wire of resistance 20 ohm carries a current of 0.5 A. Find the potential difference across the wire.",
    "expected": { "value": 10.0, "unit": "V" },
    "rubric": [
      {
        "id": "formula",
        "label": "Formula",
        "marks": 1,
        "check": "formula",
        "accept": ["V = I * R", "V = IR", "V = R * I", "I = V / R", "R = V / I"]
      },
      {
        "id": "substitution",
        "label": "Substitution",
        "marks": 1,
        "check": "substitution",
        "expect": { "I": 0.5, "R": 20.0 }
      },
      {
        "id": "calculation",
        "label": "Calculation",
        "marks": 1,
        "check": "numeric",
        "target": 10.0,
        "tolerance": 0.01,
        "depends_on": "substitution"
      },
      {
        "id": "unit",
        "label": "Unit",
        "marks": 1,
        "check": "unit",
        "accept": ["V", "volt", "volts"]
      }
    ]
  },
  {
    "id": "phy-res-02",
    "subject": "physics",
    "class": 10,
    "statement": "Two resistors of 6 ohm and 3 ohm are connected in parallel across a 12 V battery. Calculate the equivalent resistance and the total current drawn from the battery.",
    "expected": { "value": 6.0, "unit": "A" },
    "rubric": [
      {
        "id": "parallel_formula",
        "label": "Parallel Resistance Formula",
        "marks": 1,
        "check": "formula",
        "accept": ["1/R_p = 1/R_1 + 1/R_2", "R_p = (R_1 * R_2)/(R_1 + R_2)", "1/R = 1/R1 + 1/R2", "R = (R1*R2)/(R1+R2)"]
      },
      {
        "id": "parallel_sub",
        "label": "Parallel Substitution",
        "marks": 1,
        "check": "substitution",
        "expect": { "R_1": 6.0, "R_2": 3.0 }
      },
      {
        "id": "req_calc",
        "label": "Equivalent Resistance Calculation",
        "marks": 1,
        "check": "numeric",
        "target": 2.0,
        "tolerance": 0.01,
        "depends_on": "parallel_sub"
      },
      {
        "id": "current_formula",
        "label": "Ohm's Law for Total Current",
        "marks": 1,
        "check": "formula",
        "accept": ["I = V / R_p", "I = V / R", "V = I * R_p", "V = I * R"]
      },
      {
        "id": "current_calc",
        "label": "Total Current Calculation",
        "marks": 1,
        "check": "numeric",
        "target": 6.0,
        "tolerance": 0.01,
        "depends_on": "req_calc"
      }
    ]
  },
  {
    "id": "phy-lens-03",
    "subject": "physics",
    "class": 10,
    "statement": "An object is placed 30 cm in front of a concave mirror of focal length 20 cm. Find the image distance using the mirror formula.",
