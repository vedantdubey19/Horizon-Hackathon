      },
      {
        "id": "substitution",
        "label": "Substitution with Sign Convention",
        "marks": 1,
        "check": "substitution",
        "expect": { "f": -20.0, "u": -30.0 }
      },
      {
        "id": "calculation",
        "label": "Image Distance Calculation",
        "marks": 1,
        "check": "numeric",
        "target": -60.0,
        "tolerance": 0.5,
        "depends_on": "substitution"
      },
      {
        "id": "unit",
        "label": "Unit",
        "marks": 1,
        "check": "unit",
        "accept": ["cm", "centimeter", "centimeters", "centimetres"]
      }
    ]
  },
  {
    "id": "phy-kin-04",
    "subject": "physics",
    "class": 11,
    "statement": "A car accelerates uniformly from rest at 2.5 m/s^2 for 8 seconds. Find its final velocity.",
