      },
      {
        "id": "substitution",
        "label": "Coefficient Identification & Substitution",
        "marks": 1,
        "check": "substitution",
        "expect": { "a": 2.0, "b": -7.0, "c": 3.0 }
      },
      {
        "id": "discriminant",
        "label": "Discriminant Calculation",
        "marks": 1,
        "check": "numeric",
        "target": 25.0,
        "tolerance": 0.01,
        "depends_on": "substitution"
      },
      {
        "id": "roots",
        "label": "Roots Evaluation",
        "marks": 1,
        "check": "numeric",
        "target": 3.0,
        "tolerance": 0.01,
        "depends_on": "discriminant"
      }
    ]
  },
